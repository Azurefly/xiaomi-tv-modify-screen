<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/cast_focus_fill" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/cast_glass_fill" />
            <stroke android:width="@dimen/cast_hairline" android:color="@color/cast_glass_stroke" />
        </shape>
    </item>
</selector>
