<?xml version="1.0" encoding="utf-8"?>
<!-- Unfocused: 7% glass + 12% hairline. Focused: white fill, dark ink comes from textColor. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cast_focus_fill" />
            <corners android:radius="@dimen/cast_radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cast_glass_fill" />
            <stroke android:width="@dimen/cast_hairline" android:color="@color/cast_glass_stroke" />
            <corners android:radius="@dimen/cast_radius_button" />
        </shape>
    </item>
</selector>
