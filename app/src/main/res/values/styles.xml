<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/cast_focus_fill</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/cast_background</item>
    </style>

    <!-- Remaining system dialogs (exit confirmation) inherit this so nothing falls back to light Material. -->
    <style name="CastDialog" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@color/cast_dialog_surface</item>
        <item name="android:colorAccent">@color/cast_status_green</item>
        <item name="android:textColorPrimary">@color/cast_text_primary</item>
        <item name="android:textColorSecondary">@color/cast_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="CastText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/cast_text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CastText.Display">
        <item name="android:textSize">@dimen/cast_text_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="CastText.Title">
        <item name="android:textSize">@dimen/cast_text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CastText.DialogTitle">
        <item name="android:textSize">@dimen/cast_text_dialog_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CastText.Body">
        <item name="android:textSize">@dimen/cast_text_body</item>
        <item name="android:textColor">@color/cast_text_secondary</item>
    </style>

    <style name="CastText.Label">
        <item name="android:textSize">@dimen/cast_text_label</item>
        <item name="android:textColor">@color/cast_text_tertiary</item>
    </style>

    <style name="CastText.Note">
        <item name="android:textSize">@dimen/cast_text_note</item>
        <item name="android:textColor">@color/cast_text_tertiary</item>
    </style>

    <!-- One button language: 7% glass at rest, white block when focused. -->
    <style name="CastButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/cast_button_height</item>
        <item name="android:paddingLeft">@dimen/cast_button_padding</item>
        <item name="android:paddingRight">@dimen/cast_button_padding</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">@dimen/cast_text_button</item>
        <item name="android:textColor">@color/cast_btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CastButton.Primary">
        <item name="android:layout_height">@dimen/cast_button_primary_height</item>
    </style>

    <style name="CastButton.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/cast_btn_text_danger</item>
    </style>

    <style name="CastRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginBottom">@dimen/cast_gap_xs</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:paddingLeft">@dimen/cast_gap_m</item>
        <item name="android:paddingRight">@dimen/cast_gap_m</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
